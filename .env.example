# Site URL used for metadata, sitemap, and OG images (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://deard.dev

# Firebase web app config (client-side, safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Formspree form ID for the contact form
NEXT_PUBLIC_FORMSPREE_KEY=

# Comma-separated list of admin emails that can delete guestbook messages
NEXT_PUBLIC_ADMIN_EMAILS=

# GitHub source for the projects page (server-only)
GH_USERNAME=dedeard
# Optional GitHub token to raise API rate limits (server-only, never exposed)
GH_API_KEY=
